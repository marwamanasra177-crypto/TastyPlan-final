<div class="page-header">

    <div>

        <h2>
            {{#if isEdit}}
                Edit Ingredient
            {{else}}
                Add Ingredient
            {{/if}}
        </h2>

        <p>
            {{#if isEdit}}
                Update ingredient information
            {{else}}
                Create a new ingredient
            {{/if}}
        </p>

    </div>

</div>


<div class="form-card">

    <form
        action="{{#if isEdit}}/dashboard/ingredients/{{ingredient.id}}/edit{{else}}/dashboard/ingredients{{/if}}"
        method="POST"
    >

        <div class="form-group">

            <label for="name">
                Ingredient Name
            </label>

            <input
                type="text"
                id="name"
                name="name"
                value="{{ingredient.name}}"
                placeholder="Enter ingredient name"
                required
            >

        </div>


        <div class="form-actions">

            <a
                href="/dashboard/ingredients"
                class="btn-secondary"
            >
                Cancel
            </a>

            <button
                type="submit"
                class="btn-primary"
            >
                {{#if isEdit}}
                    Update Ingredient
                {{else}}
                    Create Ingredient
                {{/if}}
            </button>

        </div>

    </form>

</div>