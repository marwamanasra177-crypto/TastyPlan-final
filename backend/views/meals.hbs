<div class="page-header">

<div>
    <h2>Meals</h2>
    <p>Manage recipes</p>
</div>

<a href="/dashboard/meals/new" class="btn-primary">
    + Add Meal
</a>

</div>

<div class="table-card">

<table>

    <thead>

        <tr>
            <th>ID</th>
            <th>Image</th>
            <th>Name</th>
            <th>Category</th>
            <th>Area</th>
            <th>Actions</th>
        </tr>

    </thead>


    <tbody>

        {{#each meals}}

            <tr>

                <td>{{id}}</td>

                <td>

                    {{#if image}}

                        <img
                            src="{{image}}"
                            alt="{{name}}"
                            class="meal-thumbnail"
                        >

                    {{else}}

                        No image

                    {{/if}}

                </td>

                <td>
                    {{name}}
                </td>

                <td>

                    {{#if category}}
                        {{category.name}}
                    {{else}}
                        -
                    {{/if}}

                </td>

                <td>

                    {{#if area}}
                        {{area.name}}
                    {{else}}
                        -
                    {{/if}}

                </td>

                <td class="actions">

                    <a href="/dashboard/meals/{{id}}/edit">
                        Edit
                    </a>

                    <form
                        action="/dashboard/meals/{{id}}/delete"
                        method="POST"
                        style="display:inline;"
                    >

                        <button type="submit">
                            Delete
                        </button>

                    </form>

                </td>

            </tr>

        {{else}}

            <tr>

                <td colspan="6">
                    No meals found.
                </td>

            </tr>

        {{/each}}

    </tbody>

</table>


</div>
