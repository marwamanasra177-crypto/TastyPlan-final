<div class="page-header">

    <div>
        <h2>Categories</h2>
        <p>Manage recipe categories</p>
    </div>

    <a
        href="/dashboard/categories/new"
        class="btn-primary"
    >
        + Add Category
    </a>

</div>


<div class="table-card">

    <table>

        <thead>

            <tr>
                <th>ID</th>
                <th>Image</th>
                <th>Name</th>
                <th>Description</th>
                <th>Actions</th>
            </tr>

        </thead>


        <tbody>

            {{#each categories}}

                <tr>

                    <td>{{id}}</td>

                    <td>

                        {{#if image}}

                            <img
                                src="{{image}}"
                                alt="{{name}}"
                                class="category-image"
                            >

                        {{else}}

                            No image

                        {{/if}}

                    </td>

                    <td>{{name}}</td>

                    <td>
                        {{description}}
                    </td>

                    <td class="actions">

                        <a
                            href="/dashboard/categories/{{id}}/edit"
                        >
                            Edit
                        </a>

                        <form
                            action="/dashboard/categories/{{id}}/delete"
                            method="POST"
                            style="display:inline;"
                        >

                            <button type="submit">
                                Delete
                            </button>

                        </form>

                    </td>

                </tr>

            {{else}}

                <tr>

                    <td colspan="5">
                        No categories found.
                    </td>

                </tr>

            {{/each}}

        </tbody>

    </table>

</div>